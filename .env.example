# AgentOS 环境变量示例：复制为 .env 后按需修改
# 命名规则：AGENTOS_ + 配置路径，嵌套字段使用双下划线分隔

AGENTOS_ENVIRONMENT=local
AGENTOS_DEBUG=false

# ---- LLM ----
# provider 可选 echo（本地确定性客户端）或 openai_compatible
AGENTOS_LLM__PROVIDER=echo
AGENTOS_LLM__MODEL=gpt-4o-mini
AGENTOS_LLM__BASE_URL=https://api.openai.com/v1
AGENTOS_LLM__API_KEY=
AGENTOS_LLM__TIMEOUT_SECONDS=60
AGENTOS_LLM__MAX_RETRIES=2

# 阿里云百炼 / DashScope（OpenAI 兼容模式）示例：
#   AGENTOS_LLM__PROVIDER=openai_compatible
#   AGENTOS_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AGENTOS_LLM__MODEL=qwen3.8-max
#
# 专属工作空间（百炼 MaaS，地址与密钥在控制台下载的 CSV 中）示例：
#   AGENTOS_LLM__BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#
# 模型额度用尽时直接替换 MODEL 即可，例如 qwen3.8-flash / qwen3.7-plus

# ---- Runtime ----
AGENTOS_RUNTIME__DEFAULT_AGENT=assistant
AGENTOS_RUNTIME__MAX_ITERATIONS=8

# ---- Registry（Agent 持久化）----
# 默认内存实现，进程重启即清空；开启后 Agent 定义落盘到 SQLite
AGENTOS_REGISTRY__PERSIST=false
AGENTOS_REGISTRY__DB_PATH=.agentos/agents.db

# ---- Auth（API 认证）----
# 默认关闭以方便本地开发；一旦对外暴露就必须开启并配置至少一个密钥。
# 开启但没配密钥时会拒绝所有请求（fail closed），不会退化成不校验。
AGENTOS_AUTH__ENABLED=false
# JSON 数组，可配置多个密钥便于轮换
AGENTOS_AUTH__API_KEYS=[]
AGENTOS_AUTH__HEADER_NAME=X-API-Key

# ---- Memory（会话短期记忆）----
# 未显式传 session_id 时使用的默认会话；设为空字符串可恢复无状态
AGENTOS_MEMORY__DEFAULT_SESSION_ID=default
# 单个会话保留的最大消息条数（超出按完整轮次截断）
AGENTOS_MEMORY__MAX_MESSAGES_PER_SESSION=50
# 进程内保留的最大会话数，超出按 LRU 淘汰
AGENTOS_MEMORY__MAX_SESSIONS=1000

# 长期记忆：跨会话持久化到 SQLite，按关键词召回
AGENTOS_MEMORY__LONG_TERM_ENABLED=true
AGENTOS_MEMORY__LONG_TERM_DB_PATH=.agentos/memory.db
AGENTOS_MEMORY__LONG_TERM_AUTO_RECALL=true
AGENTOS_MEMORY__LONG_TERM_RECALL_LIMIT=5

# ---- Tools（本地工具：文件与命令）----
# 文件工具的沙箱根目录，所有文件读写都被限制在此目录内
AGENTOS_TOOLS__WORKSPACE_ROOT=.
# 是否允许写文件；覆盖已有文件仍需模型显式传入 overwrite=true
AGENTOS_TOOLS__ALLOW_FILE_WRITE=true
# 是否允许执行 shell 命令。危险：命令不受沙箱约束，默认关闭
AGENTOS_TOOLS__ALLOW_SHELL=false
AGENTOS_TOOLS__SHELL_TIMEOUT_SECONDS=30
AGENTOS_TOOLS__MAX_READ_BYTES=256000
AGENTOS_TOOLS__MAX_OUTPUT_CHARS=16000

# ---- 联网工具 ----
AGENTOS_TOOLS__WEB_TIMEOUT_SECONDS=15
AGENTOS_TOOLS__MAX_WEB_BYTES=512000
# 联网搜索（Tavily 兼容接口）。填了 API Key 才会注册 web_search 工具
AGENTOS_TOOLS__WEB_SEARCH_API_URL=https://api.tavily.com/search
AGENTOS_TOOLS__WEB_SEARCH_API_KEY=
AGENTOS_TOOLS__WEB_SEARCH_MAX_RESULTS=5

# ---- API ----
AGENTOS_API__HOST=127.0.0.1
AGENTOS_API__PORT=8000
AGENTOS_API__ENABLE_DOCS=true

# ---- Logging ----
AGENTOS_LOGGING__LEVEL=INFO
AGENTOS_LOGGING__FORMAT=console